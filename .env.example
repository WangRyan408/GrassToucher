# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Right-click the server/channel with Developer Mode on -> Copy ID
GUILD_ID=
EVENT_FORUM_ID=
DIGEST_CHANNEL_ID=

# IANA timezone assumed when /event create omits the timezone option
DEFAULT_TZ=America/Los_Angeles

# Ping attendees this many minutes before an event starts
REMINDER_MINUTES=60

# Archive an event's thread this many hours after it started
ARCHIVE_GRACE_HOURS=12

# Where to rank address suggestions from — roughly the middle of your area.
# Right-click a spot in Google Maps, or read them off the URL at openstreetmap.org.
# Set both or neither. Leave them out and results are ranked globally, so searching
# "dolores park" can hand you one in Argentina. Distant addresses still work either way.
PLACE_BIAS_LAT=37.7749
PLACE_BIAS_LON=-122.4194
